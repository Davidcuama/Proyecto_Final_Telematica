! =====================================================================
! AS2 - SWITCH SW1 (Cisco Catalyst 2960-24TT)
! Rol: VLAN 10 (10.0.0.0/24) entre PC1 y el gateway AS2-R1 (Req. 1.c)
! =====================================================================
enable
configure terminal
hostname AS2-SW1
no ip domain-lookup

vlan 10
 name CLIENTES_10.0.0.0
exit
vlan 20
 name CLIENTES_172.16.0.0
exit
vlan 30
 name SERVIDOR_DHCP
exit

! 1. Puerto de acceso hacia AS2-PC1 (VLAN 10)
interface FastEthernet0/1
 description AS2-PC1_VLAN10
 switchport mode access
 switchport access vlan 10
 spanning-tree portfast
 no shutdown
exit

! 2. Puerto de acceso hacia AS2-R1 Gi0/0 (gateway 10.0.0.1 - VLAN 10)
interface FastEthernet0/2
 description AS2-R1_Gi0/0_Gateway_VLAN10
 switchport mode access
 switchport access vlan 10
 no shutdown
exit

! 3. Puertos libres para más hosts de la VLAN 10
interface range FastEthernet0/3 - 24
 switchport mode access
 switchport access vlan 10
 spanning-tree portfast
exit

end
write memory
