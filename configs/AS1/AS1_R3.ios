! =====================================================================
! AS1 - ROUTER R3 (Cisco 2911, sin módulos adicionales)
! Rol: Gateway de 172.16.0.0/24 (VLAN 20) y de la red del servidor DHCP
!      192.168.1.96/29 (VLAN 30) mediante Router-on-a-Stick + DHCP Relay
!      + OSPF Proceso 1
!
! Por qué Router-on-a-Stick: el 2911 solo trae 3 puertos (Gi0/0, Gi0/1,
! Gi0/2) y R3 tiene 4 vecinos (PC2, DHCP, R1, R4). En lugar de inventar un
! puerto Gi0/3 (no existe en el 2911), PC2 y el servidor DHCP se conectan a
! AS1-SW2 en VLANs distintas (20 y 30) y llegan a R3 por un único enlace
! troncal 802.1Q en Gi0/0. Esto además implementa la segmentación por VLAN
! pedida en el requerimiento 1.c.
! =====================================================================
enable
configure terminal
hostname AS1-R3
no ip domain-lookup

! 1. Loopback de identificación
interface Loopback0
 description Loopback_AS1_R3
 ip address 192.168.1.203 255.255.255.255
exit

! 2. Interfaz física troncal hacia AS1-SW2 (Gi0/1). Sin IP: la IP va en las subinterfaces
interface GigabitEthernet0/0
 description Troncal_802.1Q_hacia_AS1-SW2_Gi0/1
 no ip address
 no shutdown
exit

! 2a. Subinterfaz VLAN 20 - Red de clientes 172.16.0.0/24 + DHCP Relay
interface GigabitEthernet0/0.20
 description VLAN20_Clientes_172.16.0.0/24
 encapsulation dot1Q 20
 ip address 172.16.0.1 255.255.255.0
 ip helper-address 192.168.1.100
exit

! 2b. Subinterfaz VLAN 30 - Red del servidor DHCP de AS1 (192.168.1.96/29)
interface GigabitEthernet0/0.30
 description VLAN30_Servidor_DHCP_192.168.1.96/29
 encapsulation dot1Q 30
 ip address 192.168.1.97 255.255.255.248
exit

! 3. Enlace interno hacia AS1-R1
interface GigabitEthernet0/1
 description Enlace_Interno_a_AS1-R1_Gi0/1
 ip address 192.168.1.2 255.255.255.252
 no shutdown
exit

! 4. Enlace interno hacia AS1-R4
interface GigabitEthernet0/2
 description Enlace_Interno_a_AS1-R4_Gi0/2
 ip address 192.168.1.9 255.255.255.252
 no shutdown
exit

! 5. IGP: OSPF Proceso 1 (Área 0)
router ospf 1
 router-id 1.1.1.3
 passive-interface GigabitEthernet0/0.20
 passive-interface GigabitEthernet0/0.30
 network 172.16.0.0 0.0.0.255 area 0
 network 192.168.1.0 0.0.0.3 area 0
 network 192.168.1.8 0.0.0.3 area 0
 network 192.168.1.96 0.0.0.7 area 0
 network 192.168.1.203 0.0.0.0 area 0
exit

end
write memory
