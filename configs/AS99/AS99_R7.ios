! =====================================================================
! AS99 - ROUTER R7 (Modelo recomendado: Cisco 2911)
! Rol: Router de Acceso al Servidor WEB (203.0.113.128/26) + OSPF Proceso 99
! =====================================================================
enable
configure terminal
hostname AS99-R7
no ip domain-lookup

! 1. Interfaz Loopback para identificación en AS99
interface Loopback0
 description Loopback_AS99_R7
 ip address 203.0.113.207 255.255.255.255
exit

! 2. Interfaz LAN hacia el Servidor WEB de AS99 (203.0.113.130/26)
interface GigabitEthernet0/0
 description Conexion_a_Servidor_WEB_AS99_(203.0.113.130)
 ip address 203.0.113.129 255.255.255.192
 no shutdown
exit

! 3. Enlace interno hacia AS99-R6 (Gi0/1)
interface GigabitEthernet0/1
 description Enlace_Interno_a_AS99-R6_Gi0/1
 ip address 203.0.113.6 255.255.255.252
 no shutdown
exit

! 4. Enlace interno hacia AS99-R5 (Gi0/2)
interface GigabitEthernet0/2
 description Enlace_Interno_a_AS99-R5_Gi0/2
 ip address 203.0.113.10 255.255.255.252
 no shutdown
exit

! 5. Enrutamiento Interno del Proveedor (IGP): OSPF Proceso 99 (Área 0)
router ospf 99
 router-id 99.99.99.7
 passive-interface GigabitEthernet0/0
 network 203.0.113.4 0.0.0.3 area 0
 network 203.0.113.8 0.0.0.3 area 0
 network 203.0.113.128 0.0.0.63 area 0
 network 203.0.113.207 0.0.0.0 area 0
exit

end
write memory
